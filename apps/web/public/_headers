# Workers static assets headers for the Witness web app.
# No inline scripts or styles anywhere: fonts come from Google Fonts, everything else from here.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Ready-made Apple Shortcuts (scripts/shortcuts/build.mjs), served as files to save. The file
# name is the shortcut's name: Shortcuts names an imported shortcut after its file. Exact paths
# only, so a mistyped /shortcuts/ URL still gets the app's normal page, not a download.
/shortcuts/send-to-witness.shortcut
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Send to Witness.shortcut"
  Cache-Control: public, max-age=3600

/shortcuts/send-image-to-witness.shortcut
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="Send image to Witness.shortcut"
  Cache-Control: public, max-age=3600
