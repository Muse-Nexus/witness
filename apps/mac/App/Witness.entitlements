<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Hardened runtime, not sandboxed: reading ~/Library/Messages/chat.db needs Full Disk
	Access granted to this exact app, which the App Sandbox would not allow. The only
	resource entitlement is Contacts, used when the person turns on names.
	-->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
</dict>
</plist>
