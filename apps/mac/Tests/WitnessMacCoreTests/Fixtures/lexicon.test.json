        { "p": "❤️", "w": 0.2 }
      ]
    },
    "accomplishment": {
      "phrases": [
        { "p": "congrats", "w": 0.4 },
        { "p": "congratulations", "w": 0.5 }
      ],
      "patterns": []
    },
    "care": {
      "phrases": [
        { "p": "you made my day", "w": 0.6 },
        { "p": "here for you", "w": 0.5 }
      ],
      "patterns": []
